# Copy to .env for local use (never commit .env). On Render put these in Environment Variables.
DEBUG=1
SECRET_KEY=change-this-to-a-long-random-string

# OTP email via Brevo API
BREVO_API_KEY=xkeysib-paste-key
BREVO_SENDER_EMAIL=you@gmail.com
BREVO_SENDER_NAME=Exam Crack Study Point

# Razorpay (use TEST keys first: rzp_test_...)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional: keep uploaded news images/videos permanently (S3-compatible: Cloudflare R2, AWS S3, Supabase Storage)
S3_BUCKET=
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=
S3_PUBLIC_URL=
